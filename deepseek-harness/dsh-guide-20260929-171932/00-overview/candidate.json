  "cards": [
    {
      "dot": "cyan",
      "title": "启动：一切皆插件",
      "items": [
        "dsh --profile <name> 选择 web / headless / sdk / sdk-minimal / acp",
        "层叠顺序：bundle（dsh-base → dsh-web-app）→ profile patch → home patch → --patch",
        "Cordis Loader 按 id 挂载每一行；注册均为 effect，卸载时自动回滚"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行：Turn / Step",
      "items": [
        "Step = 一次模型请求 + 其调用的工具；Turn = 0..n 个 Step",
        "agent/pre-step、agent/request、llm/stream、tools/* 均为瀑布事件，需调用 next()",
        "工具还欠请求或有新输入时进入下一 Step"
      ]
    },
    {
      "dot": "violet",
      "title": "Session 日志是事实源",
      "items": [
        "模型可见 ⟺ 已记录：deriveMessages() 从日志投影历史",
        "持久化插件订阅 session/event，异步写 JSONL，session/flush 时落盘",
        "Web 实时增量来自 agent/assistant-stream"
      ]
    },
    {
      "dot": "rose",
      "title": "能力接缝（Seam）",
      "items": [
        "Service Definition / Provider / Consumer 三角色",
        "fs 与 subprocess 共享执行世界：换成远程沙箱，Bash/PTY/LSP 一起迁移",
        "默认 workspace-write 沙箱 + ask 审批策略"
      ]
    }
  ]
