  "cards": [
    {
      "dot": "cyan",
      "title": "两条通道",
      "items": [
        "一次性调用（prompt / create / commands）走 HTTP POST /api/<ns>/<method>",
        "持续推送（follow / control / $events）走 WebSocket /api/remote.mux",
        "两条通道都先经过 Connection 的信任校验"
      ]
    },
    {
      "dot": "emerald",
      "title": "消息怎么交给 Agent",
      "items": [
        "Session Controller 先找到 Agent：内存里有就用，否则从磁盘恢复（resume）或新建（create）",
        "followup 把消息放进 inbox 的 next-turn 队列，并写一条 agent/inbox/spliced 事件",
        "inbox 的状态完全由日志事件折叠而来，重启后也不会丢"
      ]
    },
    {
      "dot": "violet",
      "title": "结果怎么回到浏览器",
      "items": [
        "每次 session.append 都会广播 session/event；模型吐字时还有 agent/assistant-stream 实时帧",
        "session.follow 流把这些事件打包成 WS item 帧推给客户端",
        "客户端先收到快照，再增量追加，所以断线重连不会漏消息"
      ]
    }
  ]
}
