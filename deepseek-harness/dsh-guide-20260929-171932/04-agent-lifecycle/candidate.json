  "cards": [
    {
      "dot": "cyan",
      "title": "只有三种内部阶段",
      "items": [
        "idle：空闲等待；maintenance：初始化或维护任务；running：驱动在跑 turn",
        "对外的 agent/status 只有 idle / running，maintenance 对外也显示 idle",
        "没有“disposed/error”阶段：出错会发 agent/error 并回到 idle"
      ]
    },
    {
      "dot": "emerald",
      "title": "怎么被唤醒",
      "items": [
        "followup(msg) 放进 next-turn 并唤醒；steer(msg) 放进 next-step 并唤醒；inject(msg) 只放入不唤醒",
        "唤醒时 idle → running，新建一个 AbortController，开始 while(await turn()) 循环",
        "每个 turn 结束时若 inbox 还有消息，就换一个新的 AbortController 继续下一 turn"
      ]
    },
    {
      "dot": "rose",
      "title": "中止与释放",
      "items": [
        "cancel(cause) 默认清空 inbox，然后触发 abort；驱动在 finally 里自己回到 idle",
        "turn/end 记录原因：completed / blocked / max-tokens / aborted / error",
        "dispose：cancel(disposed) → 等待 idle → 释放作用域 → 关闭日志句柄 → 离开注册表"
      ]
    }
  ]
