  "cards": [
    { "dot": "cyan", "title": "入口（谁在用它）", "items": [
      "CLI、TUI、桌面 App、聊天网关、定时任务、IDE(ACP) 都复用同一个 AIAgent",
      "网关把 Telegram/Discord/Slack 等消息统一成 MessageEvent 再交给智能体"
    ] },
    { "dot": "emerald", "title": "核心循环", "items": [
      "每轮：组装请求 → 调模型 → 有 tool_calls 就执行工具并把结果放回 → 再调模型",
      "没有工具调用时，模型文本就是最终回复；CLI 默认最多 500 轮"
    ] },
    { "dot": "violet", "title": "学习与记忆", "items": [
      "memory 工具把要点写进 MEMORY.md / USER.md，下次会话开局读入",
      "系统提示词整场对话保持不变，保护提示词缓存；只有上下文压缩例外"
    ] },
    { "dot": "amber", "title": "扩展方式", "items": [
      "工具在 tools/*.py 中自注册到 registry；按 toolset 开关",
      "平台、模型提供方、记忆后端等以 plugins/ 插件形式接入",
      "delegate_task 可派生子 AIAgent 并行干活"
    ] }
  ]
