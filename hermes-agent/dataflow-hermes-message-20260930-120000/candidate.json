  "cards": [
    {
      "dot": "emerald",
      "title": "主干：一问一答",
      "items": [
        "消息经网关进入，拼上系统提示词和历史，发给大模型",
        "模型直接给出文字 → 发回用户，本次结束"
      ]
    },
    {
      "dot": "amber",
      "title": "循环：边想边做",
      "items": [
        "模型要求调用工具 → 执行（跑命令、读写文件、搜网页）",
        "工具结果作为 tool 消息放回对话，再次请求模型，直到不再调用工具"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么提示词不变",
      "items": [
        "系统提示词在会话开始时构建一次，之后字节不变",
        "这样模型服务商能复用缓存，省钱省时间；只有上下文压缩会重建"
      ]
    }
  ]
