  "cards": [
    { "dot": "cyan", "title": "① 回合开始", "items": [
      "拿到会话锁，保证同一个会话不会同时跑两个回合",
      "把用户消息加进对话；首轮构建系统提示词；必要时先压缩；用户消息先写进 state.db"
    ] },
    { "dot": "emerald", "title": "② 每次迭代", "items": [
      "检查是否被打断、预算是否用完，然后扣一次预算",
      "组装本次要发的消息，太长就先压缩，再以流式方式请求模型；网络或限流错误会自动重试"
    ] },
    { "dot": "amber", "title": "③ 分支：动手还是回答", "items": [
      "有 tool_calls：先把助手消息存库，再执行工具，结果以 tool 消息追加，然后回到 ② 继续",
      "没有：这就是最终答复，检查空回复后存库，跳出循环"
    ] },
    { "dot": "rose", "title": "④ 收尾", "items": [
      "预算用完还没答案时，会额外请求一次让模型做总结",
      "同步外部记忆、按需启动后台复盘，返回 final_response 和完整 messages"
    ] }
  ]
