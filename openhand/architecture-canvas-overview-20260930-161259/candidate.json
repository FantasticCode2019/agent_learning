  "cards": [
    {
      "dot": "cyan",
      "title": "前端分层",
      "items": [
        "页面只调用 hooks，hooks 包装 src/api 服务",
        "本地后端直接用 @openhands/typescript-client",
        "Canvas 不重新实现 Agent Server 接口"
      ]
    },
    {
      "dot": "violet",
      "title": "后端选择",
      "items": [
        "注册表区分 local / cloud 后端，存于 localStorage",
        "cloud：POST /api/v1/app-conversations + 任务轮询",
        "local：加密 settings 后直接创建会话"
      ]
    },
    {
      "dot": "emerald",
      "title": "实时事件",
      "items": [
        "WS 用 after_seq 游标续传，历史先走 REST 预加载",
        "WS 未连接时 sendMessage 回退到 REST sendEvent",
        "plan 模式另开规划子会话的第二条 WS"
      ]
    },
    {
      "dot": "amber",
      "title": "本地栈",
      "items": [
        "npx @openhands/agent-canvas 或 Electron 一键启动",
        "Ingress 统一 :8000，另有 /vscode 前缀给编辑器",
        "版本与端口集中在 config/defaults.json"
      ]
    }
  ]
