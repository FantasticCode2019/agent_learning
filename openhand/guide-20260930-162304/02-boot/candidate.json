  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "页面先决定“连哪个后端”，再确认它能用，最后才渲染界面",
        "后端信息只存在浏览器 localStorage 里"
      ]
    },
    {
      "dot": "violet",
      "title": "local 与 cloud",
      "items": [
        "local：请求头带 X-Session-API-Key，并探测 /server_info",
        "cloud：Bearer Token，只做健康检查 /api/keys/current"
      ]
    },
    {
      "dot": "amber",
      "title": "健康与切换",
      "items": [
        "后端每 30s 探活，连续 5 次失败标记禁用",
        "切换后端会清掉缓存的 server_info 并重新探测"
      ]
    }
  ]
