  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "先用 REST 把最近的历史拉下来显示，再开 WebSocket 接收之后的新事件",
        "after_seq 是“我已经看到第几条”，服务端只补发后面的"
      ]
    },
    {
      "dot": "violet",
      "title": "安全",
      "items": [
        "Key 不放在 URL 里，连接后第一帧发 {type:auth}",
        "握手超过 10s 未完成会被主动关闭"
      ]
    },
    {
      "dot": "amber",
      "title": "容错",
      "items": [
        "非正常关闭会显示连接错误横幅，可手动重试",
        "store 按事件 id 去重，重放不会产生重复消息"
      ]
    }
  ]
