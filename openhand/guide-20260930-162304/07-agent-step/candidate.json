  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "一步 = 把历史整理成对话 → 问 LLM“下一步做什么” → 执行它选的工具",
        "工具结果变成新事件，下一步 LLM 就能看到"
      ]
    },
    {
      "dot": "emerald",
      "title": "默认工具",
      "items": [
        "terminal：在 tmux 里执行命令",
        "file_editor：查看 / 编辑文件",
        "task_tracker：维护 TASKS.md；另有 Think、Finish"
      ]
    },
    {
      "dot": "rose",
      "title": "安全闸门",
      "items": [
        "确认策略判定为高风险的动作，先暂停等待人工确认",
        "用户拒绝时生成 UserRejectObservation，LLM 会看到被拒绝"
      ]
    }
