  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "每个事件先写成磁盘上的一个 JSON 文件，写成功后才通知订阅者",
        "所以前端断线后，总能从磁盘把漏掉的事件补回来"
      ]
    },
    {
      "dot": "emerald",
      "title": "两条流",
      "items": [
        "正式事件：落盘，带 seq 序号，走 DurableFrame",
        "打字机效果的 token 片段：不落盘，走 ItemStarted / Delta 帧",
        "正式事件到达后，前端按 id 收起临时片段"
      ]
    },
    {
      "dot": "amber",
      "title": "背压保护",
      "items": [
        "每个连接一个写线程，队列上限 16 MiB",
        "消费太慢时直接断开连接（1013），不会拖慢 Agent"
      ]
    }
  ]
