  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "服务端推来的每一帧先分类：流式文字走缓冲，正式事件进 Store，同时触发界面副作用",
        "聊天区只渲染加工后的 uiEvents"
      ]
    },
    {
      "dot": "emerald",
      "title": "加工规则",
      "items": [
        "工具的执行结果（Observation）会替换对应的动作卡片（Action）",
        "正式事件到达时，按事件 id 收起对应的流式临时槽",
        "Think / Finish 的结果被丢弃，只保留动作本身"
      ]
    },
    {
      "dot": "amber",
      "title": "副作用举例",
      "items": [
        "命令 → 终端面板；浏览器截图 → 浏览器面板",
        "改文件 → 刷新文件变更与 diff 缓存",
        "error 帧 → 顶部错误横幅，连接保持"
      ]
    }
  ]
