  "cards": [
    {
      "dot": "cyan",
      "title": "一句话理解",
      "items": [
        "每个会话都有一个执行状态，随事件推送给前端，决定界面上显示什么按钮",
        "发新消息会把 FINISHED / STUCK 重置为 IDLE"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复路径",
      "items": [
        "WAITING：接受 → 回到 RUNNING 并执行动作；拒绝 → IDLE",
        "PAUSED / ERROR / STUCK 再次 run() 都会回到 RUNNING"
      ]
    },
    {
      "dot": "violet",
      "title": "前端怎么显示",
      "items": [
        "IDLE→等待输入，RUNNING→停止按钮，PAUSED→继续按钮",
        "WAITING→确认/拒绝按钮，ERROR / STUCK→错误图标"
      ]
    }
  ]
