  "cards": [
    {
      "dot": "emerald",
      "title": "问答（同步路径）",
      "items": [
        "用户提问经 API 进入问答编排，SSE 流式返回",
        "RAG：查询理解 → 并行检索 → Rerank → 合并 → 大模型生成",
        "Agent 模式：大模型多步推理，把知识检索当作工具调用"
      ]
    },
    {
      "dot": "amber",
      "title": "入库（异步路径）",
      "items": [
        "上传只保存文件并记一条 Knowledge，随即返回",
        "API、问答编排和 Worker 都跑在同一个 app 容器（同一 Go 进程）里",
        "Asynq Worker 后台解析、分块、向量化并写索引",
        "失败最多重试 3 次，状态写回 Knowledge"
      ]
    },
    {
      "dot": "slate",
      "title": "可替换组件",
      "items": [
        "检索引擎：Postgres / ES / OpenSearch / Qdrant / Milvus / Weaviate 等",
        "文件存储、模型厂商都可以通过配置更换"
      ]
    }
  ]
