  "cards": [
    {
      "dot": "amber",
      "title": "上半部分：入库",
      "items": [
        "文件先保存、再入队，上传接口立即返回",
        "Worker 把文档解析成 Markdown，再切成小块",
        "每块文字存 PostgreSQL，向量写进检索引擎"
      ]
    },
    {
      "dot": "emerald",
      "title": "下半部分：问答",
      "items": [
        "先理解并改写问题，再同时查向量和关键词",
        "Rerank 模型按相关度重排，只保留最有用的几块",
        "大模型参考这些分块作答，并标出出处"
      ]
    },
    {
      "dot": "slate",
      "title": "两条路径的交汇点",
      "items": [
        "检索引擎：入库时写入，问答时读取",
        "两边必须使用同一个 Embedding 模型，向量才能对得上"
      ]
    }
  ]
