  "cards": [
    {
      "dot": "emerald",
      "title": "为什么这么快就返回",
      "items": [
        "上传接口只做三件事：存文件、记一条“待处理”记录、投递后台任务",
        "真正耗时的解析和向量化交给后台 Worker，用户不用干等"
      ]
    },
    {
      "dot": "amber",
      "title": "查重与校验",
      "items": [
        "文件大小受 MAX_FILE_SIZE_MB 限制；只有管理员 / 编辑可上传",
        "用文件的 MD5 + 名称 + 大小判断是否重复，重复直接返回 409"
      ]
    },
    {
      "dot": "rose",
      "title": "失败怎么办",
      "items": [
        "写库失败会删掉刚存的文件，避免孤儿文件",
        "入队失败把记录标成 failed，但仍把记录返回给前端"
      ]
    }
  ]
