  "cards": [
    {
      "dot": "cyan",
      "title": "ReAct 是什么",
      "items": [
        "Reason + Act：模型先想“下一步该做什么”，再调用工具，看到结果后继续想",
        "直到模型认为信息足够、不再调用工具，就输出最终答案"
      ]
    },
    {
      "dot": "emerald",
      "title": "常用工具",
      "items": [
        "默认：search_knowledge 查知识库、read_document 读文档、list_documents 列文档、search_conversations 查历史对话",
        "可选：联网搜索 / 抓网页、知识图谱、数据库查询、数据分析、沙箱 Shell、MCP、本机浏览器、Wiki"
      ]
    },
    {
      "dot": "rose",
      "title": "安全阀",
      "items": [
        "最多 20 轮，用完就用已有结果强制总结",
        "上下文太长会自动压缩历史；输出被截断、重复、空回答都有重试上限",
        "外部 MCP 工具可配置为需要用户点“同意”才执行"
      ]
    },
    {
      "dot": "amber",
      "title": "中途插话（Steer）",
      "items": [
        "Agent 运行中用户还能继续发消息，下一轮开始前会被注入对话"
      ]
    }
  ]
