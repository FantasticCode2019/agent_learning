  "cards": [
    {
      "dot": "cyan",
      "title": "第 1 步 · 解析",
      "items": [
        "txt / md / csv 等简单格式直接用 Go 读取",
        "Office、PDF 优先交给进程内的 anydoc，或走 Python DocReader（gRPC）",
        "输出统一是 Markdown；音频先语音转文字，图片单独存储"
      ]
    },
    {
      "dot": "emerald",
      "title": "第 2 步 · 分块",
      "items": [
        "按段落、换行、句号切成约 512 字的小块，相邻块重叠 80 字防止断句",
        "开启父子块时：小块（384）用于检索，大块（4096）给大模型看"
      ]
    },
    {
      "dot": "violet",
      "title": "第 3 步 · 索引",
      "items": [
        "每块文字调用 Embedding 模型得到向量",
        "默认存进 PostgreSQL 的 embeddings 表：pgvector 存向量、BM25 做关键词",
        "失败会清理已写的分块和索引，避免“半截数据”"
      ]
    },
    {
      "dot": "amber",
      "title": "第 4 步 · 后处理（可选）",
      "items": [
        "图片 OCR / 看图描述、文档摘要、自动出题、自动打标签、知识图谱",
        "全部完成后文档状态才变为 completed"
      ]
    }
  ]
