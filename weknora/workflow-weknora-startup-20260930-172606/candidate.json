  "cards": [
    {
      "dot": "cyan",
      "title": "依赖注入是什么",
      "items": [
        "WeKnora 用 dig 容器统一创建对象：先有配置，再有数据库，再有服务",
        "每个服务只声明自己需要什么，容器负责按顺序把它们拼好"
      ]
    },
    {
      "dot": "amber",
      "title": "两种运行模式",
      "items": [
        "有 Redis：启动 6 个 Asynq 任务池（core / postprocess / enrichment 等）",
        "没有 Redis：退化为同步执行任务，适合轻量体验"
      ]
    },
    {
      "dot": "slate",
      "title": "退出时",
      "items": [
        "收到信号后先停止接收请求，再清理资源（ResourceCleaner）"
      ]
    }
  ]
